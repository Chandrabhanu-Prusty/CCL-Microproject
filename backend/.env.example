# ===================================================
# Amazon DynamoDB Table Names (Supplied at deploy)
# ===================================================
USERS_TABLE=MarqueUsers
EVENTS_TABLE=MarqueEvents
EVENT_STAFF_TABLE=MarqueEventStaff
RSVPS_TABLE=MarqueRSVPs
WAITLIST_TABLE=MarqueWaitlist
TICKETS_TABLE=MarqueTickets

# ===================================================
# Amazon S3 Bucket Name (Supplied at deploy)
# ===================================================
S3_BUCKET=placeholder-actual-bucket-name

# ===================================================
# Security & Auth Tokens (Supplied at deploy)
# ===================================================
JWT_SECRET=placeholder-secure-random-256-bit-key
JWT_EXPIRES_IN=24h

# Optional: used only once during initial organizer bootstrap;
# remove or leave undefined once bootstrap is complete
BOOTSTRAP_SECRET=placeholder-one-time-bootstrap-key

# ===================================================
# AWS Region
# ===================================================
AWS_REGION=ap-south-1

# ===================================================
# Multi-Origin CORS (Development & Production)
# ===================================================
# Comma-separated list of exact origins or wildcard patterns
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app

