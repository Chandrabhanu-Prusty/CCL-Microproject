{
  "name": "marque-backend",
  "version": "1.0.0",
  "description": "Marque Campus Event Management Platform - AWS Serverless Backend",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "test:ts": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "marque",
    "aws",
    "serverless",
    "lambda",
    "dynamodb",
    "s3"
  ],
